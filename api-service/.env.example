# ============================
# 课狐 ClassFox Lite - 环境变量配置（Slim：webspeech + sherpa-onnx）
# ============================

# FastAPI 后端端口
# Lite 版默认 8766，可与 v1.2.0 正式版（8765）同时运行，方便对比测试
API_PORT=8766

# OpenAI Compatible API 配置（救场 / 进度 / 总结用，与语音识别无关）
LLM_BASE_URL=https://api.deepseek.com/
LLM_API_KEY=sk-your-api-key
LLM_MODEL=deepseek-chat

# ASR 模式: webspeech / sherpa / mock
# webspeech: WebView2 Web Speech（微软在线识别，免 key，需联网，推荐）
# sherpa:    本地流式识别（sherpa-onnx streaming Zipformer，CPU 推理，免联网）
# mock:      空实现，仅测试 UI
ASR_MODE=webspeech

# 浏览器识别语言
WEBSPEECH_LANG=zh-CN

# ---- sherpa 本地识别配置 ----
# 模型目录；留空则使用 <程序根目录>/models/<SHERPA_MODEL_NAME>
# SHERPA_MODEL_DIR=
# 模型目录名（models/ 下的文件夹名）
SHERPA_MODEL_NAME=sherpa-onnx-streaming-zipformer-small-bilingual-zh-en-2023-02-16
# CPU 推理线程数
SHERPA_NUM_THREADS=2
# 一句话结束后多少秒静音判定断句
SHERPA_RULE1_SILENCE=2.4
# 输入设备索引（可选）。留空用系统默认麦克风；
# 填立体声混音/扬声器回环设备的索引可识别电脑正在播放的声音
# SHERPA_INPUT_DEVICE=

# 录音参数（sherpa 模式采集用）
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SIZE=3200

# 转录策略
# 0: 保留完整课堂转录（默认）
# 1: 每 50 行滚动压缩为历史摘要，减少上下文体积
TRANSCRIPT_ENABLE_ROLLING_SUMMARY=0
